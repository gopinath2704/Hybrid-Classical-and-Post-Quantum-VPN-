[Unit]
Description=PQ-VPN client service (privileged backend for desktop GUI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/pqvpn/.venv/bin/python -m app.client --service --config /etc/pqvpn/client.toml
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pqvpn
ReadWritePaths=/run/pqvpn

[Install]
WantedBy=multi-user.target
