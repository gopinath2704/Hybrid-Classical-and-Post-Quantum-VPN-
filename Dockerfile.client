# Dockerfile for Hybrid VPN Client Node
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    openvpn \
    net-tools \
    iproute2 \
    iptables \
    iputils-ping \
    liboqs-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt

CMD ["python3", "-m", "vpn.engine.tunnel_daemon"]
