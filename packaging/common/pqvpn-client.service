[Unit]
Description=PQ-VPN managed client service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m app.client --service
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pqvpn
StateDirectory=pqvpn
StateDirectoryMode=0700
ReadWritePaths=/run/pqvpn /var/lib/pqvpn
UMask=0077

[Install]
WantedBy=multi-user.target
