Description: Let debian/control own distribution runtime dependencies
 The upstream Python project pins PyPI release versions. Ubuntu 26.04 supplies
 compatible Argon2 and cryptography under distribution package names, so
 retaining the PyPI requirements would make dh_python3 emit unsatisfiable
 PyPI-version dependencies. liboqs and its Python binding are not in Debian
 repos and must be installed manually (see docs/deployment.md).
Author: PQ-VPN research project <noreply@example.invalid>
Forwarded: not-needed
Last-Update: 2026-09-19
---
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -11,7 +11 @@
-dependencies = [
-  "argon2-cffi==25.1.0",
-  "cryptography==50.0.1",
-  "fastapi==0.141.1",
-  "liboqs-python==0.16.0",
-  "uvicorn==0.52.4",
-]
+dependencies = []
