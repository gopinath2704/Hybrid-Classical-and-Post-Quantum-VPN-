# Maintainer: PQ-VPN research project
pkgname=pqvpn
pkgver=3.0.0
pkgrel=1
pkgdesc='Hybrid classical and post-quantum research VPN client for Linux'
arch=('x86_64')
url='https://github.com/gopinath2704/Hybrid-Classical-and-Post-Quantum-VPN-'
license=('custom')
# liboqs 0.16.0 and liboqs-python are required but not packaged by Arch.
# Install before building: sudo bash scripts/install-liboqs.sh /usr/local
# then: pip install liboqs-python==0.16.0
depends=('python>=3.11' 'python-argon2-cffi' 'python-cryptography' 'python-fastapi' 'uvicorn' 'pyside6' 'iproute2' 'nftables')
install=pqvpn.install
# aws-lc-sys C objects built with makepkg's -flto are unlinkable from rustc (undefined aws_lc_* symbols).
options=('!lto')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'cargo' 'maturin')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('743885842beb228835360032374d3a7176be23bb2d3c577f431194791b57bcd5')

prepare() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  # ponytail: crates come from crates.io here, pinned by Cargo.lock; vendor them into the tarball for fully offline builds.
  cargo fetch --locked --manifest-path core/Cargo.toml
}

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  PYTHONNOUSERSITE=1 python -m build --wheel --no-isolation
  maturin build --release --frozen --compatibility linux -m core/pqvpn_core/Cargo.toml -o dist-core
  cargo build --release --frozen --manifest-path core/Cargo.toml -p pqvpnd
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  PYTHONNOUSERSITE=1 python -m installer --destdir="${pkgdir}" dist/*.whl
  PYTHONNOUSERSITE=1 python -m installer --destdir="${pkgdir}" dist-core/*.whl
  install -Dm755 core/target/release/pqvpnd "${pkgdir}/usr/bin/pqvpnd"
  # Pacman-managed launchers must not import packages from the invoking user's ~/.local.
  sed -i '1c #!/usr/bin/python -s' "${pkgdir}/usr/bin/pqvpn" "${pkgdir}/usr/bin/pqvpn-gui" "${pkgdir}/usr/bin/pqvpn-account-api"
  install -Dm644 packaging/common/pqvpn.desktop "${pkgdir}/usr/share/applications/pqvpn.desktop"
  install -Dm644 packaging/common/pqvpn.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/pqvpn.svg"
  install -Dm644 packaging/common/pqvpn-client.service "${pkgdir}/usr/lib/systemd/system/pqvpn-client.service"
  install -Dm644 packaging/common/pqvpn-account-api.service "${pkgdir}/usr/lib/systemd/system/pqvpn-account-api.service"
  install -Dm644 packaging/common/pqvpn.conf "${pkgdir}/usr/lib/sysusers.d/pqvpn-account.conf"
  install -Dm644 config/account-api.toml "${pkgdir}/etc/pqvpn/account-api.toml"
  install -Dm755 scripts/install-liboqs.sh "${pkgdir}/usr/share/${pkgname}/install-liboqs.sh"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 docs/design.md "${pkgdir}/usr/share/doc/${pkgname}/design.md"
  install -Dm644 docs/deployment.md "${pkgdir}/usr/share/doc/${pkgname}/deployment.md"
  install -Dm644 docs/accounts.md "${pkgdir}/usr/share/doc/${pkgname}/accounts.md"
}
